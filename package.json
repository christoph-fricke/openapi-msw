{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "openapi-msw",
  "type": "module",
  "version": "2.1.1",
  "license": "MIT",
  "author": "Christoph Fricke <christoph@frickeonline.de>",
  "description": "Tiny, type-safe wrapper around MSW for type inference from OpenAPI schemas.",
  "repository": "github:christoph-fricke/openapi-msw",
  "files": [
    "dist",
    "exports",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/exports/main.d.ts",
      "default": "./dist/exports/main.js"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.1"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "lint": "eslint . && prettier -c .",
    "test": "vitest run",
    "generate": "openapi-typescript -c ./test/fixtures/.redocly.yml",
    "version": "changeset version && npm i"
  },
  "peerDependencies": {
    "msw": "^2.10.5 || ^3.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "fsevents": false
  }
}
